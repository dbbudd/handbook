{
  "name": "handbook-site-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Builds the PnP provisioning template for the HKIS Teaching & Learning Handbook from index.html",
  "scripts": {
    "build": "node build-template.mjs",
    "build:seed": "node build-template.mjs --seed-content",
